<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>pl.com.sofitfy.enhanced_containers</groupId>
    <artifactId>enhanced_containers-integration-tests</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <paper.version>1.21.11-R0.1-SNAPSHOT</paper.version>
        <mockbukkit.version>4.101.0</mockbukkit.version>
        <junit.version>5.10.2</junit.version>

        <!-- Opt-in: ciężkie testy uruchamiające prawdziwy serwer Paper -->
        <realPaperIT>false</realPaperIT>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spinamy wersje JUnit-a w jednym miejscu -->
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- 3 pluginy - budowane przez Gradle, instalowane do lokalnego repo Maven -->
        <dependency>
            <groupId>pl.com.sofitfy.enhanced_containers</groupId>
            <artifactId>shared-crafting</artifactId>
            <version>1.0-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>pl.com.sofitfy.enhanced_containers</groupId>
            <artifactId>enhanced-crafting</artifactId>
            <version>1.0-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>pl.com.sofitfy.enhanced_containers</groupId>
            <artifactId>enhanced-furnaces</artifactId>
            <version>1.0-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>

        <!-- API do kompilacji testów -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- MockBukkit do uruchomienia fake serwera i ładowania pluginów -->
        <dependency>
            <groupId>org.mockbukkit.mockbukkit</groupId>
            <artifactId>mockbukkit-v1.21</artifactId>
            <version>${mockbukkit.version}</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>io.papermc.paper</groupId>
                    <artifactId>paper-api</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.junit.jupiter</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.junit.platform</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- JUnit 5 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Mockito -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.12.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>5.12.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <useModulePath>false</useModulePath>
                    <argLine>-Dnet.bytebuddy.experimental=true</argLine>
                </configuration>
            </plugin>

            <!-- Failsafe: testy integracyjne (*IT.java, *IntegrationTest.java) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <useModulePath>false</useModulePath>
                    <argLine>-Dnet.bytebuddy.experimental=true</argLine>
                    <systemPropertyVariables>
                        <realPaperIT>${realPaperIT}</realPaperIT>
                    </systemPropertyVariables>
                    <includes>
                        <include>**/*IT.java</include>
                        <include>**/*IntegrationTest.java</include>
                    </includes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
              Budujemy 3 pluginy (JARy) przez Gradle i instalujemy do lokalnego Maven repo.
              Każdy plugin jest osobnym modułem Gradle.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <!-- Krok 1: Buduj wszystkie pluginy przez Gradle -->
                    <execution>
                        <id>build-plugin-jars-gradle</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <workingDirectory>${project.basedir}/..</workingDirectory>
                            <executable>./gradlew</executable>
                            <arguments>
                                <argument>build</argument>
                                <argument>-x</argument>
                                <argument>test</argument>
                            </arguments>
                        </configuration>
                    </execution>

                    <!-- Krok 2: Instaluj SharedCrafting JAR -->
                    <execution>
                        <id>install-shared-crafting-jar</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>mvn</executable>
                            <arguments>
                                <argument>install:install-file</argument>
                                <argument>-Dfile=${project.basedir}/../shared-crafting/build/libs/shared-crafting-unspecified.jar</argument>
                                <argument>-DgroupId=pl.com.sofitfy.enhanced_containers</argument>
                                <argument>-DartifactId=shared-crafting</argument>
                                <argument>-Dversion=1.0-SNAPSHOT</argument>
                                <argument>-Dpackaging=jar</argument>
                            </arguments>
                        </configuration>
                    </execution>

                    <!-- Krok 3: Instaluj EnhancedCrafting JAR -->
                    <execution>
                        <id>install-enhanced-crafting-jar</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>mvn</executable>
                            <arguments>
                                <argument>install:install-file</argument>
                                <argument>-Dfile=${project.basedir}/../enhanced-crafting/build/libs/enhanced-crafting-unspecified.jar</argument>
                                <argument>-DgroupId=pl.com.sofitfy.enhanced_containers</argument>
                                <argument>-DartifactId=enhanced-crafting</argument>
                                <argument>-Dversion=1.0-SNAPSHOT</argument>
                                <argument>-Dpackaging=jar</argument>
                            </arguments>
                        </configuration>
                    </execution>

                    <!-- Krok 4: Instaluj EnhancedFurnaces JAR -->
                    <execution>
                        <id>install-enhanced-furnaces-jar</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>mvn</executable>
                            <arguments>
                                <argument>install:install-file</argument>
                                <argument>-Dfile=${project.basedir}/../enhanced-furnaces/build/libs/enhanced-furnaces-unspecified.jar</argument>
                                <argument>-DgroupId=pl.com.sofitfy.enhanced_containers</argument>
                                <argument>-DartifactId=enhanced-furnaces</argument>
                                <argument>-Dversion=1.0-SNAPSHOT</argument>
                                <argument>-Dpackaging=jar</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
